{
  "name": "mg-utils-php-codegen",
  "private": true,
  "type": "module",
  "description": "Dev-only: generates PHP tables in src/ from the spec/ submodule. Not shipped to Packagist.",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "codegen": "node tools/codegen/index.ts",
    "new-module": "node tools/new-module/index.ts",
    "hooks": "lefthook install",
    "lint": "tsc -p tsconfig.json --noEmit && knip"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
